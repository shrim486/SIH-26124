DATABASE_URL=sqlite:///./app.db
SECRET_KEY=replace-with-a-random-local-secret
GOVERNMENT_USERNAME=admin
GOVERNMENT_PASSWORD=replace-with-a-local-password

# Local route planning; switch to your own providers for larger deployments.
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-car
# Optional: set ROUTING_PROVIDER=tomtom and provide a TomTom Routing API key
# to use traffic-aware durations and route alternatives.
# Citywide map traffic also needs Traffic Flow Tiles and Raster Incident Tiles
# enabled for the same key. Keep secrets in backend/.env.
ROUTING_PROVIDER=osrm
TOMTOM_API_KEY=
GEOCODING_BASE_URL=https://photon.komoot.io
MAP_USER_AGENT=GenMaps-RoutePlanner/1.0 (https://github.com/shrim486/SIH-26124)
